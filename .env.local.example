# Copy this file to .env.local (which is gitignored) and fill in real
# values. Never commit .env.local. See docs/AUTH_SETUP.md for how to
# obtain each of these.

# --- Database -----------------------------------------------------------
# Full Postgres connection string. Local dev can point at a local Postgres
# instance, a free Neon/Supabase project, or Docker — anything Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/the_collective"

# --- Auth.js core ---------------------------------------------------------
# Auth.js signs/encrypts session cookies with this. Generate one with:
#   npx auth secret
# (or: openssl rand -base64 33)
# Must be set in every environment (local AND production) and must be a
# different value in production than in development.
AUTH_SECRET=""

# Required in production so Auth.js knows its own public URL when
# constructing the Discord redirect URI. Not required for local dev
# (defaults to http://localhost:3000).
# AUTH_URL="https://yourdomain.com"

# --- Discord OAuth --------------------------------------------------------
# From the Discord Developer Portal -> your application -> OAuth2.
# See docs/AUTH_SETUP.md for the full walkthrough.
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
