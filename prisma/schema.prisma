// Phase 2 — Authentication Foundation
//
// This schema intentionally contains ONLY what authentication needs.
// Profile, Comment, Award, Report, Role, etc. (see the architecture
// blueprint) are added in later phases as new models with relations
// pointing at User.id — none of them require changing anything below.
//
// Account / Session / VerificationToken follow the exact shape required
// by @auth/prisma-adapter. Do not rename their columns — the adapter
// reads/writes these field names directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// The authenticated identity. Deliberately holds only Discord-derived
// identity fields for now, not display/profile content — that split is
// intentional (see the architecture blueprint, Section 3.2: "a `User`
// existing does not mean a `Profile` exists").
model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  displayName String?
  avatarUrl   String?

  // Not used anywhere in the app today — we deliberately request only the
  // "identify" Discord scope, never "email". These two columns exist
  // purely because Auth.js's core AdapterUser type always includes
  // `email` and `emailVerified` on every createUser/updateUser call,
  // regardless of provider. The Prisma adapter passes that object
  // straight into `prisma.user.create/update`, so without matching
  // columns here it throws "Unknown argument `emailVerified`" — this is
  // a fixed contract of every Auth.js database adapter, not something
  // specific to Discord. Leave them nullable and don't populate them;
  // if email/password or magic-link sign-in is ever added, these are
  // already the columns Auth.js will use.
  email         String?   @unique
  emailVerified DateTime?

  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  // Phase 3 — Profile ownership. Optional and unique: a User can exist
  // without ever claiming a Profile, and can own at most one. The actual
  // foreign key lives on Profile.userId (see below); this is just the
  // reverse relation Prisma needs to expose `user.profile`.
  profile Profile?

  // Future phases attach here without touching any existing column:
  // comments  Comment[]
  // roles     UserRole[]
  // reports   Report[]
}

// One row per linked OAuth provider account. Only Discord exists today;
// this shape is what lets a second provider be added later without
// touching User at all.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Database session strategy (not JWT) — chosen so an admin ban can
// invalidate a session immediately by deleting this row, rather than
// waiting for a JWT to expire. See architecture blueprint, Section 4.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required by the Prisma adapter's contract even though Discord-only
// OAuth doesn't use it today (it backs email/passwordless sign-in).
// Kept so the adapter's full interface is satisfied without workarounds.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Phase 3 — Profile ownership & editing.
//
// A `User` existing does not mean a `Profile` exists, and vice versa: every
// current member starts out as an *unclaimed* Profile (see prisma/seed.ts)
// with `userId` null, so the member pages keep working for signed-out
// visitors exactly as before. Signing in with Discord only creates a
// `User` row — a Profile is claimed separately, on purpose, so identity
// (who you are to Discord) and public profile content (what the site
// shows about you) stay decoupled, the same split the User model's own
// comment already calls out.
//
// `slug` is what member pages key off (`/members/[slug]`), independent of
// whether the profile has been claimed — this is what keeps the existing
// static routes working unchanged.
model Profile {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  realName    String?
  bio         String   @db.Text
  avatar      String?
  banner      String?
  city        String?
  country     String?

  // Freeform platform -> URL map (see data/types.ts's `Socials` type,
  // which this is intended to round-trip through). Left as JSON rather
  // than one column per platform so adding a platform never requires a
  // migration.
  socials Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null until the profile is claimed; set exactly once, at claim time
  // (see actions/profile.ts). Not touched by subsequent edits.
  claimedAt DateTime?

  // Nullable + unique together are what encode "may belong to exactly one
  // User" and "one User can own only one Profile": nullable allows the
  // unclaimed state, unique is the DB-level guarantee (backed by an
  // atomic `updateMany` in the claim action) that two users can never
  // successfully claim the same profile, and that a claim can never
  // silently attach a second Profile to a User who already has one.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // If the linked User is ever deleted, the Profile itself is NOT deleted
  // (onDelete: SetNull, not Cascade) — it just reverts to unclaimed and
  // stays visible with whatever content was last saved. Losing a Discord
  // account shouldn't erase a member's page.

  // Phase 4 — Discord server membership sync (lib/discord.ts,
  // lib/discord-sync.ts). Deliberately stored on Profile, not User: this
  // is public-facing display state ("is this member in our server?"),
  // the same kind of thing as displayName/avatar/bio above, not
  // authentication state. A Profile with no linked User (unclaimed) has
  // no Discord identity to check, so these simply stay at their defaults
  // until the profile is claimed.
  //
  // All three "server*"/"discord*" fields are written ONLY by
  // lib/discord-sync.ts's syncDiscordMembership(), and only from a
  // successful Discord Bot API response — never from anything the
  // client sends. If Discord is unreachable, the sync function leaves
  // whatever was last written here untouched (see its comments) rather
  // than resetting to "not a member", so a transient Discord outage
  // never makes a real member look like they left.
  serverMember   Boolean   @default(false)
  serverJoinedAt DateTime?

  // Array of Discord role IDs (strings), e.g. ["123456789012345678"].
  // Not rendered anywhere yet — the requirements are explicit that
  // role-based UI is a future phase — but captured now so that future
  // phase can start reading this column on day one instead of needing
  // another migration.
  discordRoles Json @default("[]")

  // When the fields above were last successfully written. Lets the UI
  // (or a future admin view) distinguish "confirmed not a member as of
  // this timestamp" from "we've never been able to check" — both look
  // like serverMember: false otherwise.
  discordSyncedAt DateTime?
}
